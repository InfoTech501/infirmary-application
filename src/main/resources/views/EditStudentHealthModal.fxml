<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

   <stylesheets>
      <URL value="@../styles/buttons.css" />
      <URL value="@../styles/label.css" />
      <URL value="@../styles/table.css" />
      <URL value="@../styles/label.css" />
   </stylesheets>

   <center>
       <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
           <VBox prefHeight="620.0" prefWidth="514.0" spacing="10.0">
               <HBox.margin>
                   <Insets />
               </HBox.margin>
               <padding>
                   <Insets left="30.0" top="10.0" />
               </padding>
               <Label text="Student Info:" />
               <Label text="First name" />
               <Label text="Middle name" />
               <Label text="Last name" />
               <Label text="Sex" />
               <Label text="Age" />
               <Label text="Section" />
               <Label text="Contact number" />
               <Label text="Address" />
               <Label text="Email" />
           </VBox>
       </HBox>

   </center>
   <top>
       <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="1400.0" BorderPane.alignment="CENTER">
            <Label fx:id="LabelEditInformation" text="EDIT STUDENT HEALTH INFORMATION">
                <HBox.margin>
                    <Insets left="30.0" />
                </HBox.margin>
            </Label>
       </HBox>
   </top>
   <bottom>
      <ButtonBar prefHeight="73.0" prefWidth="1400.0" BorderPane.alignment="CENTER">
        <buttons>
          <Button mnemonicParsing="false" text="Confirm Changes" />
            <Button mnemonicParsing="false" text="Cancel" />
        </buttons>
         <padding>
            <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
         </padding>
      </ButtonBar>
   </bottom>
</BorderPane>
