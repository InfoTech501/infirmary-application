<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="530.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rocs.infirmary.application.controller.student.profile.SHPMedicalRecordsController">

   <stylesheets>
      <URL value="@../styles/buttons.css" />
      <URL value="@../styles/label.css" />
      <URL value="@../styles/table.css" />
      <URL value="@../styles/label.css" />
   </stylesheets>

   <center>
       <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
           <VBox prefHeight="310.0" prefWidth="518.0" spacing="10.0">
               <HBox.margin>
                   <Insets />
               </HBox.margin>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Illnes/Symptoms:" />
                      <Label fx:id="illnessLabel" text="data" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Visit date:" />
                      <Label fx:id="visitDateLabel" text="data" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Temperature:" />
                      <Label fx:id="temperatureLabel" text="data" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Blood Pressure:" />
                      <Label fx:id="bloodPressureLabel" text="data" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Pulse Rate:" />
                      <Label fx:id="pulseRateLabel" text="data" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Respiratory Rate:" />
                      <Label fx:id="respiratoryRate" text="data" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Treatment:" />
                     <Label fx:id="treatmentLabel" text="data" />
               </children>
            </HBox>
           </VBox>


           <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <VBox prefHeight="90.0" prefWidth="1070.0">
                   <Label text="Illness/ Symptoms" />
                   <TextField fx:id="updateIllnessTextField" prefHeight="45.0" prefWidth="1070.0" />
               </VBox>
               <VBox prefHeight="90.0" prefWidth="1070.0">
                   <Label text="Temperature" />
                   <TextField fx:id="updateTemperatureTextField" prefHeight="45.0" prefWidth="1070.0" />
               </VBox>
               <VBox prefHeight="90.0" prefWidth="1070.0">
                   <Label text="Treatment" />
                   <TextField fx:id="updateTreatmentTextField" prefHeight="45.0" prefWidth="1070.0" />
               </VBox>
               <VBox prefHeight="90.0" prefWidth="1070.0">
                   <Label text="Visit Date" />
                   <DatePicker fx:id="updateVisitDatePicker" prefHeight="45.0" prefWidth="312.0" />
               </VBox>
           </VBox>
         <padding>
            <Insets top="30.0" />
         </padding>
       </HBox>

   </center>
   <bottom>
      <ButtonBar BorderPane.alignment="CENTER">
        <buttons>
          <Button fx:id="confirmChangesBtn" mnemonicParsing="false" prefHeight="60.0" text="Confirm Changes" />
            <Button fx:id="deleteMedicalRecordBtn" mnemonicParsing="false" prefHeight="60.0" text="Delete Medical Record">
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Button>
        </buttons>
         <padding>
            <Insets bottom="5.0" left="30.0" right="30.0" top="5.0" />
         </padding>
      </ButtonBar>
   </bottom>
   <top>
      <VBox prefWidth="1400.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_LEFT" prefWidth="1400.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="MANAGE MEDICAL RECORDS" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" top="20.0" />
         </BorderPane.margin>
      </VBox>
   </top>
</BorderPane>
